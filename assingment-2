def original_ways(n):
    if n <= 1:
        return 1
    return original_ways(n - 1) + original_ways(n - 2)
# Redesigned iterative solution
def redesigned_ways(n):
    if n <= 1:
        return 1
    a = 1
    b = 1
    for i in range(2, n + 1):
        c = a + b
        a = b
        b = c
    return b
