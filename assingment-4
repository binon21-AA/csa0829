from .validator import validate_record


def process_files(filenames):
    master = []
    seen_registers = set()
    event_groups = {}
    errors = []

    for filename in filenames:
        try:
            with open(filename, "r", encoding="utf-8") as file:
                for line_number, line in enumerate(file, start=1):
                    if not line.strip():
                        continue

                    try:
                        student = validate_record(line)

                        register_no = student["register_no"]

                        if register_no in seen_registers:
                            raise ValueError(
                                "Duplicate registration"
                            )

                        seen_registers.add(register_no)
                        master.append(student)

                        for event in student["events"]:
                            event_groups.setdefault(event, []).append(
                                student
                            )

                    except ValueError as error:
                        errors.append(
                            (filename, line_number, str(error))
                        )

        except FileNotFoundError:
            errors.append(
                (filename, 0, "Department file not found")
            )

        except PermissionError:
            errors.append(
                (filename, 0, "Permission denied")
            )

        except UnicodeDecodeError:
            errors.append(
                (filename, 0, "Invalid file encoding")
            )

        except OSError as error:
            errors.append(
                (filename, 0, str(error))
            )

    return master, event_groups, errors
