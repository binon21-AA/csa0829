def validate_email(email):
    email = email.strip().lower()

    if " " in email:
        return False

    if email.count("@") != 1:
        return False

    local, domain = email.split("@")

    if not local or not domain:
        return False

    if "." not in domain:
        return False

    if domain.startswith(".") or domain.endswith("."):
        return False

    return True


def validate_record(line):
    parts = line.strip().split(",")

    if len(parts) != 5:
        raise ValueError(
            f"Expected 5 fields, found {len(parts)}"
        )

    register_no, name, department, email, events = (
        part.strip() for part in parts
    )

    if not register_no:
        raise ValueError("Register number is missing")

    if not name:
        raise ValueError("Student name is missing")

    if not department:
        raise ValueError("Department is missing")

    if not validate_email(email):
        raise ValueError("Invalid email address")

    event_list = [
        event.strip()
        for event in events.split(";")
        if event.strip()
    ]

    if not event_list:
        raise ValueError("No events selected")

    return {
        "register_no": register_no,
        "name": name,
        "department": department,
        "email": email.lower(),
        "events": event_list
    }
