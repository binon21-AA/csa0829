import csv
from pathlib import Path


def write_reports(master, event_groups, errors):
    output_folder = Path("output")
    output_folder.mkdir(exist_ok=True)

    # Master list
    with open(
        output_folder / "master_list.csv",
        "w",
        newline="",
        encoding="utf-8"
    ) as file:

        writer = csv.writer(file)

        writer.writerow([
            "Register Number",
            "Name",
            "Department",
            "Email",
            "Events"
        ])

        for student in master:
            writer.writerow([
                student["register_no"],
                student["name"],
                student["department"],
                student["email"],
                ";".join(student["events"])
            ])

    # Event-wise files
    for event, students in event_groups.items():
        safe_name = "".join(
            ch if ch.isalnum() else "_"
            for ch in event
        )

        with open(
            output_folder / f"{safe_name}.txt",
            "w",
            encoding="utf-8"
        ) as file:

            for student in students:
                file.write(
                    f"{student['register_no']}, "
                    f"{student['name']}, "
                    f"{student['department']}\n"
                )

    # Summary report
    with open(
        output_folder / "summary.txt",
        "w",
        encoding="utf-8"
    ) as file:

        file.write("COLLEGE FEST SUMMARY\n")
        file.write(f"Total registrations: {len(master)}\n")

        for event, students in sorted(event_groups.items()):
            file.write(
                f"{event}: {len(students)} participants\n"
            )

    # Error log
    with open(
        output_folder / "errors.log",
        "w",
        encoding="utf-8"
    ) as file:

        for filename, line_number, message in errors:
            file.write(
                f"{filename}, Line {line_number}: {message}\n"
            )
