import re
from collections import Counter

STOP_WORDS = {
    "the", "is", "a", "an", "and", "or",
    "to", "of", "in", "on", "for", "are",
    "was", "were", "it", "this", "that"
}


def summarise(text, k=2):
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = re.findall(r"\b[a-zA-Z]+\b", text.lower())

    important_words = [
        word for word in words
        if word not in STOP_WORDS
    ]

    frequencies = Counter(important_words)

    scored_sentences = []

    for index, sentence in enumerate(sentences):
        sentence_words = re.findall(
            r"\b[a-zA-Z]+\b",
            sentence.lower()
        )

        sentence_score = sum(
            frequencies[word]
            for word in sentence_words
            if word not in STOP_WORDS
        )

        scored_sentences.append(
            (sentence_score, index, sentence)
        )

    selected = sorted(
        scored_sentences,
        key=lambda item: (-item[0], item[1])
    )[:k]

    selected.sort(key=lambda item: item[1])

    return " ".join(
        sentence for _, _, sentence in selected
    )


complaint = (
    "The air near the factory is dirty. "
    "Smoke is increasing every day. "
    "The roads are clean. "
    "Children are facing pollution problems."
)

print("Original:", complaint)
print("Summary:", summarise(complaint, 2))

