import csv
import random
import sqlite3
import time
from collections import defaultdict
from datetime import datetime, timedelta

import pandas as pd


def generate_data(station_count, filename):
    start = datetime(2026, 1, 1)

    with open(filename, "w", newline="") as file:
        writer = csv.writer(file)
        writer.writerow(["station", "date", "pm25"])

        for station_number in range(station_count):
            station = f"Station{station_number + 1}"

            for hour_number in range(8760):
                current = start + timedelta(hours=hour_number)

                writer.writerow([
                    station,
                    current.strftime("%Y-%m-%d"),
                    round(random.uniform(5, 150), 2)
                ])


def python_method(filename):
    groups = defaultdict(lambda: [0.0, 0])

    with open(filename, "r") as file:
        reader = csv.DictReader(file)

        for row in reader:
            key = (row["station"], row["date"])
            groups[key][0] += float(row["pm25"])
            groups[key][1] += 1

    return {
        key: total / count
        for key, (total, count) in groups.items()
    }


def pandas_method(filename):
    df = pd.read_csv(filename)

    result = df.groupby(
        ["station", "date"]
    )["pm25"].mean()

    return result


def sql_method(filename):
    con = sqlite3.connect(":memory:")

    con.execute("""
        CREATE TABLE readings (
            station TEXT,
            date TEXT,
            pm25 REAL
        )
    """)

    with open(filename, "r") as file:
        reader = csv.reader(file)
        next(reader)

        con.executemany(
            "INSERT INTO readings VALUES (?, ?, ?)",
            reader
        )

    result = con.execute("""
        SELECT station, date, AVG(pm25)
        FROM readings
        GROUP BY station, date
    """).fetchall()

    con.close()
    return result


for count in [1, 12, 120]:
    filename = f"data_{count}.csv"

    generate_data(count, filename)

    start = time.perf_counter()
    python_method(filename)
    python_time = time.perf_counter() - start

    start = time.perf_counter()
    pandas_method(filename)
    pandas_time = time.perf_counter() - start

    start = time.perf_counter()
    sql_method(filename)
    sql_time = time.perf_counter() - start

    print("\nStations:", count)
    print("Python:", python_time)
    print("Pandas:", pandas_time)
    print("SQL:", sql_time)

